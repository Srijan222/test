{
  "name": "claude-cloud-environment",
  "version": "1.0.0",
  "description": "Cloud environment setup for Claude AI",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "docker:build": "docker build -t claude-cloud-environment .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "terraform:init": "cd terraform && terraform init",
    "terraform:plan": "cd terraform && terraform plan",
    "terraform:apply": "cd terraform && terraform apply",
    "terraform:destroy": "cd terraform && terraform destroy"
  },
  "keywords": [
    "claude",
    "ai",
    "cloud",
    "aws",
    "terraform",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0"
  }
}
