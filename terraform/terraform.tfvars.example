# AWS Configuration
aws_region = "us-east-1"
environment = "dev"

# Network Configuration
vpc_cidr = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# ECS Configuration
task_cpu = "256"
task_memory = "512"
desired_count = 1

# Application Configuration
ecr_repository_url = "123456789012.dkr.ecr.us-east-1.amazonaws.com/claude-app"
app_version = "latest"
claude_model = "claude-sonnet-4-5-20250929"

# Secrets (DO NOT COMMIT - use environment variables or AWS Secrets Manager)
# anthropic_api_key = "your-api-key-here"
